{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChaosSurvivalProject/sky-resource-guard/schemas/adapter-spec.schema.json",
  "title": "SKY adapter generation spec (P1.1, observe-only)",
  "description": "Facts used to generate a ResourceParticipant adapter. Every value must be observed from the target plugin, never guessed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pluginId", "version", "packageName", "className", "serviceTier",
    "executionPhase", "faultDomain", "capabilities", "observeOnly", "sampling"
  ],
  "properties": {
    "pluginId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
      "description": "Exact plugin id from the target plugin's plugin.yml."
    },
    "pluginName": { "type": "string", "maxLength": 96 },
    "version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "description": { "type": "string", "maxLength": 300 },
    "packageName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "className": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "serviceTier": { "$ref": "#/$defs/serviceTier" },
    "executionPhase": { "$ref": "#/$defs/executionPhase" },
    "faultDomain": { "type": "string", "minLength": 1, "maxLength": 96 },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capability" },
      "description": "Only OBSERVATION capabilities are allowed while observeOnly is true."
    },
    "observeOnly": {
      "const": true,
      "description": "P1.1 hard constraint: generated adapters never mutate the world."
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initialQueueDepth", "initialHeapBytes", "stage"],
      "properties": {
        "initialQueueDepth": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "initialHeapBytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "stage": { "type": "string", "maxLength": 64 }
      }
    }
  },
  "$defs": {
    "serviceTier": {
      "enum": ["CORE", "PROTECTION", "PLAYER_SERVICE", "BACKGROUND", "OPTIONAL"]
    },
    "executionPhase": {
      "enum": ["TICK_ESSENTIAL", "WORLD_SYNC", "PLAYER_FACING", "BACKGROUND_IO", "MAINTENANCE"]
    },
    "capability": {
      "enum": [
        "LOWER_POWER", "CHECKPOINT", "QUIESCE", "RESUME", "RELEASE_RESOURCES",
        "HEALTH_CHECK", "QUEUE_REPORT", "CACHE_REPORT", "EXECUTOR_SHUTDOWN",
        "LEAK_DETECTION", "DRY_RUN"
      ]
    }
  }
}
